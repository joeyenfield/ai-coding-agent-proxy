# The build context of both images: agent-server (server/Dockerfile: server/, ui/, config/,
# benchmarks/tests) and agent-sandbox (sandbox/Dockerfile: client/, machine/, sandbox/).
.git
.env
# Local agent, environment and validation output is never part of either image.
# Some generated directories have private Windows ACLs: exclude them before the
# Compose provider walks the build context.
.claude
.context
.history
.venv
.screenshot*
.test-*
.tmp-*
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/node_modules
ui/dist
ui/tsconfig.tsbuildinfo
logs
certs
client/bin
machine/bin
dist
android
benchmarks/results
server/tests
scripts
