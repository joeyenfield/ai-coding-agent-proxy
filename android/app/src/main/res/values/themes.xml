<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AgentProxy" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- The console draws its own header; the bars take the page's colour. -->
    <style name="Theme.AgentProxy.Console">
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style name="Button.Primary" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Plain" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Field" parent="@android:style/Widget.DeviceDefault.EditText">
        <item name="android:background">@drawable/field</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/steel</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
