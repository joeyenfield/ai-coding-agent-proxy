<?xml version="1.0" encoding="utf-8"?>
<!-- agent-servers run on your own machines: plain HTTP on a LAN or Tailscale (which
     encrypts it), or HTTPS with a certificate you installed on the phone yourself. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
